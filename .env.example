# ─── Banco de Dados (Turso — SQLite remoto para produção) ─────────────────────
# Crie uma conta em https://turso.tech, crie um database e obtenha as credenciais.
# Se não configurado, o sistema usa SQLite local (ou /tmp no Vercel — efêmero).
# Execute no CLI: turso db create dou-notification && turso db tokens create dou-notification

# URL do banco Turso (formato: libsql://[db-name]-[org].turso.io)
TURSO_DATABASE_URL=libsql://dou-notification-seuorg.turso.io

# Token de autenticação do banco Turso
TURSO_AUTH_TOKEN=seu_token_turso

# ─── Configuração de E-mail (SMTP) ───────────────────────────────────────────
# Copie este arquivo para ".env" e preencha com suas credenciais reais.
# O arquivo ".env" NÃO deve ser versionado (já consta no .gitignore).

# Servidor SMTP (Gmail, Outlook, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Conta remetente
SMTP_USER=seu_email@gmail.com

# Para Gmail: use um App Password (não a senha normal).
# Gere em: https://myaccount.google.com/apppasswords
SMTP_PASS=sua_app_password_aqui

# Nome exibido no campo "De" (opcional)
SMTP_FROM=DOU Notificações <seu_email@gmail.com>

# URL da interface web (usada nos links do e-mail e WhatsApp)
# Em produção (Vercel): https://dou-notification.vercel.app
APP_URL=http://127.0.0.1:8000

# ─── Configuração de WhatsApp (Z-API) ────────────────────────────────────────
# Crie uma conta em https://z-api.io, crie uma instância e conecte seu WhatsApp.
# O número de telefone de cada usuário (campo "telefone" no cadastro) é usado
# como destinatário. Formatos aceitos: 75999999999 | (75)99999-9999 | 5575999999999

# ID da instância Z-API
ZAPI_INSTANCE_ID=sua_instance_id

# Token da instância Z-API
ZAPI_TOKEN=seu_token

# Client-Token de segurança (encontrado em Segurança > Client-Token no painel)
ZAPI_CLIENT_TOKEN=seu_client_token
